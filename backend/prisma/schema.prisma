generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prospectLists  ProspectList[]
  unipileAccount UnipileAccount?
}

model UnipileAccount {
  id               String               @id @default(uuid())
  userId           String               @unique
  user             User                 @relation(fields: [userId], references: [id])
  unipileAccountId String?
  status           UnipileAccountStatus @default(DISCONNECTED)
  connectedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProspectList {
  id     String             @id @default(uuid())
  userId String
  user   User               @relation(fields: [userId], references: [id])
  name   String
  status ProspectListStatus @default(BRIEF_SET)

  targetType           ProspectTargetType
  offerDescription     String
  valueProposition     String?
  targetIndustries     String[]
  targetCompanySizeMin Int?
  targetCompanySizeMax Int?
  targetLocations      String[]
  targetJobTitles      String[]
  additionalCriteria   String?
  exclusions           String?
  maxProspects         Int                @default(10)

  companies    ScrapedCompany[]
  prospects    Prospect[]
  scrapingRuns ScrapingRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ScrapingRun {
  id             String       @id @default(uuid())
  prospectListId String
  prospectList   ProspectList @relation(fields: [prospectListId], references: [id])

  stage           ScrapingRunStage
  status          ScrapingRunStatus @default(QUEUED)
  selectedActorId String?
  actorInput      Json?
  resultCount     Int?
  error           String?
  startedAt       DateTime?
  finishedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([prospectListId])
}

model ScrapedCompany {
  id             String       @id @default(uuid())
  prospectListId String
  prospectList   ProspectList @relation(fields: [prospectListId], references: [id])

  name              String
  domain            String?
  linkedinCompanyId String?
  linkedinUrl       String?
  email             String?
  phone             String?
  fitVerdict        FitVerdict?
  fitReason         String?
  raw               Json?

  prospects Prospect[]
  createdAt DateTime   @default(now())

  @@index([prospectListId])
}

model Prospect {
  id             String         @id @default(uuid())
  prospectListId String
  prospectList   ProspectList   @relation(fields: [prospectListId], references: [id])
  companyId      String
  company        ScrapedCompany @relation(fields: [companyId], references: [id])

  firstName   String
  lastName    String
  jobTitle    String
  linkedinUrl String?
  email       String?
  phone       String?
  fitVerdict  FitVerdict?
  fitReason   String?
  raw         Json?

  status    ProspectStatus @default(PENDING)
  createdAt DateTime       @default(now())

  @@index([prospectListId])
}

// Declaration order matters: sorting ascending puts the best fits first.
enum FitVerdict {
  MATCH
  PARTIAL
  MISMATCH
}

enum ProspectTargetType {
  B2B_COMPANIES
  AGENCIES_FREELANCERS
  LOCAL_BUSINESSES
}

enum ProspectListStatus {
  BRIEF_SET
  SCRAPING
  ENRICHING
  READY
  FAILED
}

enum ScrapingRunStage {
  COMPANY_SEARCH
  PROSPECT_ENRICHMENT
}

enum ScrapingRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ProspectStatus {
  PENDING
  MESSAGE_SENT
  REPLIED
  INTERESTED
  MEETING_BOOKED
  NOT_INTERESTED
  FAILED
}

enum UnipileAccountStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}
