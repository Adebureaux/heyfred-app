# --- Postgres ---
POSTGRES_USER=heyfred
POSTGRES_PASSWORD=heyfred
POSTGRES_DB=heyfred
DATABASE_URL=postgresql://heyfred:heyfred@postgres:5432/heyfred?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Backend ---
PORT=3000
JWT_SECRET=change-me-in-dev
JWT_EXPIRES_IN=7d
# Publicly reachable URL of this backend, used to build the Unipile webhook callback.
# Only matters once real Unipile calls are enabled — localhost isn't reachable from Unipile's
# servers, so this needs a tunnel (ngrok etc.) or a real deployment URL in that case.
BACKEND_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:9000

# --- Anthropic (actor selection AI) ---
ANTHROPIC_API_KEY=
# Only needed if your API key is workspace-scoped.
ANTHROPIC_WORKSPACE_ID=

# --- Apify ---
APIFY_API_TOKEN=

# --- Unipile ---
UNIPILE_API_KEY=
UNIPILE_BASE_URL=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:3000
